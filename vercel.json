      "destination": "/api/index"
    },
    {
      "source": "/ssl-check",
      "destination": "/api/index"
    },
    {
      "source": "/v1/ssl-check",
      "destination": "/api/index"
    },
    {
      "source": "/url-scan",
      "destination": "/api/index"
    },
    {
      "source": "/gas-price",
      "destination": "/api/index"
    },
    {
      "source": "/wallet-balance",
      "destination": "/api/index"
    },
    {
      "source": "/tx-lookup",
      "destination": "/api/index"
    },
    {
      "source": "/tvl",
      "destination": "/api/index"
    },
    {
      "source": "/crypto-price",
      "destination": "/api/index"
    },
    {
      "source": "/fx-rate",
      "destination": "/api/index"
    },
    {
      "source": "/ip-geolocation",
      "destination": "/api/index"
    },
    {
      "source": "/stock-price",
      "destination": "/api/index"
    },
    {
      "source": "/papers",
      "destination": "/api/index"
    },
    {
      "source": "/cve",
      "destination": "/api/index"
    }
  ]
}
